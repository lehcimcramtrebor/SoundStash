bin/*
!bin/.gitkeep
python_runtime/

# Logs et rapports d'exécution
logs/
*.log

# Sauvegardes et fichiers temporaires
*.old
*.bak
*.tmp

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Téléchargements temporaires et médias volatils
temp_downloads/
cover.jpg
t.jpg

