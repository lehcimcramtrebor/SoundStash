.library_cache.json
.sync_fingerprint.json
yt_dlp_update_state.json
.editor_draft.json
.reconstitute_pending.json
.migration_complete.json

# Configuration locale personnelle (chemins absolus)
config.json
playback_stats.json
/playlists/
.cache/

# Scripts de test, captures d'audit et scratch
scratch/
audit_screenshots/

